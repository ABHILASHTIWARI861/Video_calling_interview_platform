## 📁 routes/sessionRoutes.js

```js
import {
  createSessionLimiter,
  joinSessionLimiter,
  endSessionLimiter,
} from "../middleware/rateLimit.js";

router.post("/", protectRoute, createSessionLimiter, createSession);

router.get("/active", protectRoute, getActiveSessions);
router.get("/my-recent", protectRoute, getMyRecentSessions);

router.get("/:id", protectRoute, getSessionById);

router.post("/:id/join", protectRoute, joinSessionLimiter, joinSession);

router.post("/:id/end", protectRoute, endSessionLimiter, endSession);
```

