## 📁 server.js (or app.js)

```js
import { globalApiLimiter, executeLimiter } from "./middleware/rateLimit.js";

// public route (execute) pe dedicated limiter
app.use("/api/execute", executeLimiter, executeRoutes);

app.use(clerkMiddleware());

// auth-wale APIs pe global limiter
app.use(globalApiLimiter);

app.use("/api/chat", chatRoutes);
app.use("/api/sessions", sessionRoutes);
```

